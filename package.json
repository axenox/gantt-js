{
    "name": "frappe-gantt-aggregation",
    "version": "1.0.8",
    "description": "Upgraded version of frappe-gantt with support of multiple tasks per row and other features.",
    "main": "./dist/frappe-gantt-aggregation.umd.js",
    "module": "./dist/frappe-gantt-aggregation.es.js",
    "style": "./dist/frappe-gantt-aggregation.css",
    "type": "module",
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "lint": "eslint src/**/*.js",
        "prettier": "prettier --write \"{src/*,tests/*,rollup.config}.js\"",
        "prettier-check": "prettier --check \"{src/*,tests/*,rollup.config}.js\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axenox/gantt-js"
    },
    "files": [
        "dist",
        "src/styles",
        "tools/view-mode-builder.js",
        "tools/color-utils.js",
        "assets",
        "README.md",
        "license.txt"
    ],
    "exports": {
        ".": {
            "require": "./dist/frappe-gantt-aggregation.umd.js",
            "import": "./dist/frappe-gantt-aggregation.es.js",
            "style": "./dist/frappe-gantt-aggregation.css"
        }
    },
    "keywords": [
        "gantt",
        "svg",
        "simple gantt",
        "project timeline",
        "interactive gantt",
        "project management",
        "frappe-gantt-aggregation",
        "timeline-aggregation",
        "multiple-tasks-per-row"
    ],
    "author": "Sergej Riel",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/axenox/gantt-js/issues"
    },
    "homepage": "https://github.com/axenox/gantt-js",
    "devDependencies": {
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^2.9.0",
        "eslint-plugin-prettier": "^2.6.0",
        "postcss-nesting": "^12.1.2",
        "prettier": "3.2.5",
        "vite": "^7.2.4"
    },
    "eslintIgnore": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "dependencies": {
        "moment": "^2.30.1"
    }
}
